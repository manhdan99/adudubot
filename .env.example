# Cấu hình API LLM cho Adudu Chatbot
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
PORT=3000

# Cấu hình giới hạn người dùng (Rate Limit & Token Quota)
LIMIT_REQ_PER_MINUTE=12
LIMIT_REQ_PER_HOUR=35
LIMIT_TOKENS_PER_HOUR=5000
MAX_MESSAGE_CHARS=1500
